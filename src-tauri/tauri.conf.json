{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AME",
  "version": "0.1.0",
  "identifier": "ci.ame.desktop",
  "build": {
    "beforeBuildCommand": "bun run build:desktop && bun scripts/prepare-tauri-bun.mjs",
    "beforeDevCommand": "bun run build:desktop && bun scripts/prepare-tauri-bun.mjs",
    "frontendDist": "../.output/public"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/bun"],
    "resources": {
      "../.output": "output",
      "../server/migrations": "migrations"
    }
  },
  "plugins": {}
}
